<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 xmlns:vm="clr-namespace:ACS_View.ViewModels.HealthViewModels"
 x:Class="ACS_View.Views.HealthViews.PregnancyHealthView" x:DataType="vm:PregnancyHealthViewModel">
 <VerticalStackLayout Spacing="18">
  <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}"/>
  <VerticalStackLayout Spacing="6" IsVisible="{Binding HasError}">
   <Label Text="{Binding Message}" Style="{StaticResource BodyMuted}"/>
   <Button Text="Tentar novamente" Command="{Binding RetryCommand}" HorizontalOptions="Start"/>
  </VerticalStackLayout>
  <Label Text="Gestação e puerpério" Style="{StaticResource CardTitle}"/>
  <Label Text="Detalhes gestacionais não informados. Disponíveis na edição do cadastro."
   IsVisible="{Binding HasNoData}" Style="{StaticResource BodyMuted}"/>
  <VerticalStackLayout IsVisible="{Binding HasData}" Spacing="18">
   <Border StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="16"
    BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource DarkPrimaryLight}}">
    <VerticalStackLayout Spacing="6">
     <Label Text="{Binding Stage}" FontSize="12" CharacterSpacing="1"/>
     <Label Text="{Binding AgeLabel}" FontSize="12"/>
     <Label Text="{Binding Age}" FontSize="26" FontAttributes="Bold"/>
     <Label Text="{Binding Period}" FontSize="13"/>
    </VerticalStackLayout>
   </Border>
   <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
    <VerticalStackLayout Spacing="4">
     <Label Text="{Binding DateLabel}" Style="{StaticResource BodyMuted}" FontSize="12"/>
     <Label Text="{Binding ReferenceDate}" FontSize="16" FontAttributes="Bold"/>
    </VerticalStackLayout>
    <VerticalStackLayout Grid.Column="1" Spacing="4">
     <Label Text="Risco informado" Style="{StaticResource BodyMuted}" FontSize="12"/>
     <Label Text="{Binding ManualRisk}" FontSize="16" FontAttributes="Bold"/>
    </VerticalStackLayout>
   </Grid>
   <VerticalStackLayout Spacing="8">
    <Button Text="{Binding RiskButtonText}" Command="{Binding ToggleRiskCommand}"
     HorizontalOptions="Start" BackgroundColor="Transparent" Padding="0,4"
     TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryLight}}"/>
    <VerticalStackLayout IsVisible="{Binding ShowRisk}" Spacing="6">
     <Label Text="Sugestão do aplicativo" Style="{StaticResource BodyMuted}" FontSize="12"/>
     <Label Text="{Binding SuggestedRisk}" FontSize="16" FontAttributes="Bold"/>
     <Label Text="{Binding RiskReasons}" Style="{StaticResource BodyMuted}" FontSize="13"/>
    </VerticalStackLayout>
   </VerticalStackLayout>
   <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource BorderSoft}, Dark={StaticResource DarkBorderSoft}}"/>
   <VerticalStackLayout Spacing="8">
    <Button Text="{Binding RecordsButtonText}" Command="{Binding ToggleRecordsCommand}"
     HorizontalOptions="Start" BackgroundColor="Transparent" Padding="0,4"
     TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryLight}}"/>
    <VerticalStackLayout IsVisible="{Binding ShowRecords}" Spacing="8">
     <Label Text="{Binding RecordedDetails}" FontSize="13"/>
     <VerticalStackLayout IsVisible="{Binding HasNotes}" Spacing="4">
      <Label Text="Observações" FontSize="13" FontAttributes="Bold"/>
      <Label Text="{Binding Notes}" Style="{StaticResource BodyMuted}" FontSize="13"/>
     </VerticalStackLayout>
    </VerticalStackLayout>
   </VerticalStackLayout>
  </VerticalStackLayout>
 </VerticalStackLayout>
</ContentView>
