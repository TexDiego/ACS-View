<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ACS_View.ViewModels"
             xmlns:dto="clr-namespace:ACS_View.Application.DTOs"
             xmlns:controls="clr-namespace:ACS_View.Controls"
             Style="{StaticResource PageBackground}"
             x:DataType="vm:VetorialControlViewModel"
             x:Class="ACS_View.Views.VetorialControl"
             Title="Controle Vetorial">

    <ContentPage.ToolbarItems>
        <ToolbarItem
            IconImageSource="{controls:ThemedIcon Icon=Settings24, Role=OnFill}"
            Text="Configurar"
            ToolTipProperties.Text="Configurar residências em lote"
            Command="{Binding OptionsCommand}"/>
    </ContentPage.ToolbarItems>

    <ContentPage.Resources>
        <DataTemplate
            x:Key="Sector"
            x:DataType="dto:VectorControlRow">

            <Label
                Text="{Binding Title}"
                FontAttributes="Bold"
                FontSize="20"
                Padding="8,16,8,8"
                TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource AccentLight}}"/>
        </DataTemplate>

        <DataTemplate
            x:Key="Block"
            x:DataType="dto:VectorControlRow">

            <Label
                Text="{Binding Title}"
                FontAttributes="Bold"
                Padding="20,12,8,8"
                Style="{StaticResource BodyMuted}"/>
        </DataTemplate>

        <DataTemplate
            x:Key="Residence"
            x:DataType="dto:VectorControlRow">

            <Border
                Style="{StaticResource CardBorder}"
                Margin="24,2,0,4" Padding="12">

                <Border.GestureRecognizers>
                    <TapGestureRecognizer
                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:VetorialControlViewModel}}, Path=FamilyCommand}"
                        CommandParameter="{Binding .}"/>
                </Border.GestureRecognizers>

                <Label
                    Text="{Binding Title}"
                    Style="{StaticResource BodyMuted}"/>
            </Border>
        </DataTemplate>

        <controls:VectorControlTemplateSelector
            x:Key="Rows"
            SectorTemplate="{StaticResource Sector}"
            BlockTemplate="{StaticResource Block}"
            ResidenceTemplate="{StaticResource Residence}"/>

    </ContentPage.Resources>

    <Grid
        Padding="16,0"
        RowDefinitions="Auto,*"
        RowSpacing="0">

        <FlexLayout
            Direction="Row"
            Wrap="Wrap" 
            AlignItems="Center"
            Margin="0,12,0,16">

            <Picker 
                FlexLayout.Basis="240"
                ItemsSource="{Binding SearchModes}"
                SelectedIndex="{Binding SearchModeIndex, Mode=TwoWay}"/>

            <Border 
                Style="{StaticResource SearchPanel}"
                StrokeShape="RoundRectangle 5"
                FlexLayout.Grow="1"
                FlexLayout.Basis="300"
                Margin="2 ,0,0,0"
                Padding="0">
                
                <SearchBar 
                    Placeholder="{Binding SearchPlaceholder}" 
                    Text="{Binding SearchText, Mode=TwoWay}"
                    SearchCommand="{Binding SearchCommand}" 
                    MaxLength="80"/>
            </Border>
            
        </FlexLayout>

        <CollectionView
            x:Name="VectorControlCollectionView"
            Grid.Row="1"
            ItemsSource="{Binding Items}"
            ItemTemplate="{StaticResource Rows}"
            SelectionMode="None"
            Scrolled="CollectionView_Scrolled"
            VerticalScrollBarVisibility="Never">

            <CollectionView.EmptyView>
                <Label
                    Text="{Binding EmptyMessage}"
                    Style="{StaticResource BodyMuted}"
                    Padding="16"/>
            </CollectionView.EmptyView>

            <CollectionView.Footer>
                <BoxView
                    Background="Transparent"
                    HeightRequest="80"/>
            </CollectionView.Footer>

        </CollectionView>

        <ActivityIndicator
            Grid.Row="1"
            IsRunning="{Binding IsLoading}"
            IsVisible="{Binding IsLoading}"/>

        <ImageButton
            x:Name="BackToTopButton"
            Grid.RowSpan="2"
            ZIndex="1"
            Opacity="1"
            Source="{controls:ThemedIcon Icon=ArrowCircleUp24, Role=OnContainer}"
            Style="{StaticResource FloatingBackToTopButton}"
            Clicked="BackToTopButton_Clicked"/>

    </Grid>
</ContentPage>
