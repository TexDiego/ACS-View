<?xml version="1.0" encoding="utf-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:pages="clr-namespace:ACS_View.Views"
       xmlns:icons="clr-namespace:ACS_View.Controls"
       x:Class="ACS_View.Views.AppShell"
       Shell.TitleColor="White"
       Shell.BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimaryLight}}"
       Shell.ForegroundColor="White"
       Shell.TabBarTitleColor="{AppThemeBinding Light={StaticResource IconPrimary}, Dark={StaticResource DarkIconPrimary}}"
       Shell.TabBarBackgroundColor="{AppThemeBinding Light={StaticResource SurfaceContainer}, Dark={StaticResource DarkSurfaceContainer}}"
       Shell.TabBarForegroundColor="{AppThemeBinding Light={StaticResource IconPrimary}, Dark={StaticResource DarkIconPrimary}}"
       Shell.TabBarUnselectedColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}">

    <ShellContent Route="login" x:Name="LoginContent"/>

    <TabBar x:Name="MainTabBar" >

        <Tab Title="Pessoas" Icon="{icons:ThemedIcon Icon=People28, Role=Primary}">
            <ShellContent Route="registers" x:Name="RegistersPage"/>
        </Tab>

        <Tab Title="Casas" Icon="{icons:ThemedIcon Icon=HomePerson24, Role=Primary}">
            <ShellContent Route="houses" x:Name="HousesPageContent"/>
        </Tab>

        <Tab Title="Início" Icon="{icons:ThemedIcon Icon=AppFolder24, Role=Primary}">
            <ShellContent Route="overallview" x:Name="OverallViewContent"/>
        </Tab>

        <Tab Title="Visitas" Icon="{icons:ThemedIcon Icon=ClipboardHeart24, Role=Primary}">
            <ShellContent Route="visits" x:Name="AllVisitsContent"/>
        </Tab>

        <Tab Title="Perfil" Icon="{icons:ThemedIcon Icon=PersonCircle24, Role=Primary}">
            <ShellContent Route="profile" x:Name="ProfileContent"/>
        </Tab>

    </TabBar>

</Shell>
