<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:icons="clr-namespace:ACS_View.Controls"
             x:Class="ACS_View.Views.LoginPage"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             Style="{StaticResource PageBackground}">

    <ScrollView>
    <Grid Padding="24" RowDefinitions="*,auto,*" MaximumWidthRequest="600">
        <VerticalStackLayout Grid.Row="1" Spacing="18">
            <Image
                Source="{icons:ThemedIcon Icon=Form24, IconSize=112, Role=Primary}"
                HeightRequest="112"
                WidthRequest="112"
                HorizontalOptions="Center"/>

            <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                <Label Text="ACS View" Style="{StaticResource PageTitle}" HorizontalTextAlignment="Center"/>
                <Label Text="Acompanhamento comunitário" Style="{StaticResource BodyMuted}" HorizontalTextAlignment="Center"/>
            </VerticalStackLayout>

            <Label x:Name="UpdateStatus" Text="Verificando atualizações…" Style="{StaticResource BodyMuted}" HorizontalTextAlignment="Center" />
            <Border x:Name="UpdateCard" IsVisible="False" Style="{StaticResource CardBorder}" Padding="18">
                <VerticalStackLayout Spacing="10">
                    <Label x:Name="UpdateMessage" Style="{StaticResource BodyMuted}" />
                    <VerticalStackLayout x:Name="UpdateProgressPanel" IsVisible="False" Spacing="8">
                        <ProgressBar x:Name="UpdateProgress" Progress="0" />
                        <Label x:Name="UpdateProgressText" Style="{StaticResource BodyMuted}" LineBreakMode="WordWrap" />
                        <Label Text="Aguarde para entrar enquanto a atualização está em andamento." Style="{StaticResource BodyMuted}" />
                    </VerticalStackLayout>
                    <Button x:Name="InstallUpdate" Text="Instalar atualização" Style="{StaticResource PrimaryButton}" Clicked="InstallUpdate_Clicked" />
                    <Button x:Name="SkipUpdate" Text="Agora não" Style="{StaticResource GhostButton}" Clicked="SkipUpdate_Clicked" />
                    <Button x:Name="CancelDownload" Text="Cancelar download" IsVisible="False" Style="{StaticResource GhostButton}" Clicked="CancelDownload_Clicked" />
                </VerticalStackLayout>
            </Border>
            <Border x:Name="LoginForm" IsEnabled="False" Style="{StaticResource CardBorder}" Padding="18" Margin="0">
                <VerticalStackLayout Spacing="14">

                    <Entry
                        x:Name="UsernameEntry"
                        Placeholder="Nome de usuário"
                        MaxLength="64"
                        IsSpellCheckEnabled="False"
                        IsTextPredictionEnabled="False"
                        HorizontalTextAlignment="Start"/>

                    <Entry
                        x:Name="PasswordEntry"
                        Placeholder="Senha"
                        MaxLength="128"
                        IsSpellCheckEnabled="False"
                        IsTextPredictionEnabled="False"
                        IsPassword="True"
                        HorizontalTextAlignment="Start"/>

                    <Button
                        x:Name="Btn_Login"
                        Text="Entrar"
                        Style="{StaticResource PrimaryButton}"
                        Clicked="Btn_Login_Clicked"/>

                </VerticalStackLayout>
            </Border>

            <Grid x:Name="AccountActions" IsEnabled="False" ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button
                    x:Name="RegisterUser"
                    Grid.Column="0"
                    Text="Cadastre-se"
                    Style="{StaticResource GhostButton}"
                    Clicked="RegisterUser_Clicked"/>

                <Button
                    Grid.Column="1"
                    Text="Esqueci minha senha"
                    Style="{StaticResource GhostButton}"
                    TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource DarkIconDanger}}"
                    Clicked="Button_Clicked"/>
            </Grid>
        </VerticalStackLayout>
    </Grid>
    </ScrollView>
</ContentPage>
