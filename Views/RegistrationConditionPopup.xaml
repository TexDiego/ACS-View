<?xml version="1.0" encoding="utf-8" ?>
<tk:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 xmlns:tk="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
 xmlns:health="clr-namespace:ACS_View.Views.HealthViews"
 xmlns:icons="clr-namespace:ACS_View.Controls"
 x:Class="ACS_View.Views.RegistrationConditionPopup" x:Name="DetailsPopup"
 x:TypeArguments="x:Boolean" x:DataType="{x:Null}"
 BackgroundColor="Transparent" Padding="0">
 <Border Padding="18" StrokeShape="RoundRectangle 18"
 BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource DarkSurface}}">
 <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
 <Label Text="{Binding Condition.Name}" Style="{StaticResource SectionTitle}"/>
 <ScrollView Grid.Row="1">
 <VerticalStackLayout Spacing="12" BindingContext="{Binding Condition}">
                            <VerticalStackLayout

                                Margin="18,4,0,0"
                                Spacing="6"
                                IsVisible="{Binding ShowDiabetesDetails}">

                                <Grid ColumnDefinitions="*,auto,auto" ColumnSpacing="10">
                                    <Label
                                        Grid.Column="0"
                                        Text="Tipo"
                                        VerticalOptions="Center"
                                        LineBreakMode="WordWrap"
                                        FontSize="16"
                                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource DarkTextPrimary}}"
                                        Opacity="0.75"/>

                                    <Picker
                                        Grid.Column="1"
                                        Title="Não especificar"
                                        ItemsSource="{Binding Source={x:Reference DetailsPopup}, Path=BindingContext.Parent.DiabetesTypeOptions}"
                                        SelectedItem="{Binding SelectedDiabetesType, Mode=TwoWay}"
                                        FontSize="14"
                                        HorizontalOptions="End"
                                        VerticalOptions="Center"
                                        WidthRequest="190"/>

                                    <ImageButton
                                        Grid.Column="2"
                                        Source="{icons:ThemedIcon Icon=DismissCircle24, Role=Danger}"
                                        HeightRequest="22"
                                        WidthRequest="22"
                                        VerticalOptions="Center"
                                        Aspect="AspectFit"
                                        IsVisible="{Binding HasSelectedDiabetesType}"
                                        Command="{Binding Source={x:Reference DetailsPopup}, Path=BindingContext.Parent.ClearDiabetesTypeCommand}"
                                        CommandParameter="{Binding .}"/>
                                </Grid>

                                <Grid ColumnDefinitions="*,auto" ColumnSpacing="15">
                                    <Label
                                        Grid.Column="0"
                                        Text="Insulinodependente"
                                        LineBreakMode="WordWrap"
                                        FontSize="16"
                                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource DarkTextPrimary}}"
                                        Opacity="0.75"/>

                                    <CheckBox
                                        Grid.Column="1"
                                        IsChecked="{Binding InsulinDependentSelected, Mode=TwoWay}"
                                        Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryLight}}"/>
                                </Grid>

                            </VerticalStackLayout>
                            <VerticalStackLayout   IsVisible="{Binding ShowTuberculosisDetails}">
                                <health:InfectiousFollowUpForm BindingContext="{Binding Source={x:Reference DetailsPopup}, Path=BindingContext.Parent.TuberculosisEditor}"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout   Spacing="8" IsVisible="{Binding ShowImmuneDetails}">
                                <Grid ColumnDefinitions="*,Auto"><Label Text="Imunodeficiência informada" VerticalOptions="Center"/><CheckBox Grid.Column="1" IsChecked="{Binding ImmunodeficiencySelected}"/></Grid>
                                <Grid ColumnDefinitions="*,Auto"><Label Text="HIV informado" VerticalOptions="Center"/><CheckBox Grid.Column="1" IsChecked="{Binding HivSelected}"/></Grid>
                                <VerticalStackLayout IsVisible="{Binding HivSelected}">
                                    <health:InfectiousFollowUpForm BindingContext="{Binding Source={x:Reference DetailsPopup}, Path=BindingContext.Parent.HivEditor}"/>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
 <health:GlucoseMonitoringForm IsVisible="{Binding Source={x:Reference DetailsPopup}, Path=BindingContext.Condition.ShowDiabetesDetails}"
 BindingContext="{Binding Source={x:Reference DetailsPopup}, Path=BindingContext.Parent.GlucoseEditor}"/>
 </VerticalStackLayout></ScrollView>
 <Button Grid.Row="2" Text="Concluir" Style="{StaticResource Buttons}" Clicked="Done_Clicked"/>
 </Grid></Border>
</tk:Popup>
