<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             x:Class="ACS_View.Views.LoginPage"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             Style="{StaticResource PageBackground}">

    <Grid Padding="24" RowDefinitions="*,auto,*" MaximumWidthRequest="600">
        <VerticalStackLayout Grid.Row="1" Spacing="18">
            <Image
                mi:MauiIcon.Value="{mi:Fluent Icon=Form24}"
                HeightRequest="112"
                WidthRequest="112"
                HorizontalOptions="Center"/>

            <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                <Label Text="ACS View" Style="{StaticResource PageTitle}" HorizontalTextAlignment="Center"/>
                <Label Text="Acompanhamento comunitário" Style="{StaticResource BodyMuted}" HorizontalTextAlignment="Center"/>
            </VerticalStackLayout>

            <Border Style="{StaticResource CardBorder}" Padding="18" Margin="0">
                <VerticalStackLayout Spacing="14">
                    
                    <Entry 
                        x:Name="UsernameEntry" 
                        Placeholder="Nome de usuário"
                        MaxLength="64"
                        IsSpellCheckEnabled="False"
                        IsTextPredictionEnabled="False"
                        HorizontalTextAlignment="Start"/>

                    <Entry 
                        x:Name="PasswordEntry" 
                        Placeholder="Senha"
                        MaxLength="128"
                        IsSpellCheckEnabled="False"
                        IsTextPredictionEnabled="False"
                        IsPassword="True" 
                        HorizontalTextAlignment="Start"/>

                    <Button
                        x:Name="Btn_Login"
                        Text="Entrar"
                        Style="{StaticResource PrimaryButton}"
                        Clicked="Btn_Login_Clicked"/>
                    <Button x:Name="BiometricLoginButton"
                            Text="Entrar com biometria"
                            IsVisible="False"
                            Style="{StaticResource Buttons}"
                            Clicked="BiometricLogin_Clicked"/>
                    
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button
                    x:Name="RegisterUser"
                    Grid.Column="0"
                    Text="Cadastre-se"
                    Style="{StaticResource GhostButton}"
                    Clicked="RegisterUser_Clicked"/>

                <Button
                    Grid.Column="1"
                    Text="Esqueci minha senha"
                    Style="{StaticResource GhostButton}"
                    TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentLight}}"
                    Clicked="Button_Clicked"/>
            </Grid>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
