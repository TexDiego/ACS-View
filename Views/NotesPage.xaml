<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ACS_View.ViewModels"
             xmlns:model="clr-namespace:ACS_View.Domain.Entities"
             xmlns:converter="clr-namespace:ACS_View.Converters"
             xmlns:icons="clr-namespace:ACS_View.Controls"
             x:DataType="vm:NotesPageViewModel"
             x:Class="ACS_View.Views.NotesPage"
             Style="{StaticResource PageBackground}"
             Title="Anotações">

    <ContentPage.ToolbarItems>
        <ToolbarItem
            Text="Notificações"
            IconImageSource="{icons:ThemedIcon Icon=Alert24, Role=OnFill}"
            Command="{Binding ShowActiveNotificationsCommand}"/>
    </ContentPage.ToolbarItems>

    <RefreshView Command="{Binding Refresh}" IsRefreshing="{Binding IsLoading}">
        <Grid RowDefinitions="{OnPlatform Default='Auto,*', WinUI='*'}" ColumnDefinitions="{OnPlatform Default=' *', WinUI='340,*'}" ColumnSpacing="24" Padding="{StaticResource PagePadding}" RowSpacing="12">

            <Border Grid.Row="0" Style="{StaticResource CardBorder}" VerticalOptions="Start">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Nova anotação" Style="{StaticResource SectionTitle}"/>
                    <Label Text="{Binding ReminderStatus}" Style="{StaticResource BodyMuted}"/>
                    <Editor
                        BindingContext="{Binding Note}"
                        x:DataType="model:Note"
                        Text="{Binding Content, Mode=TwoWay}"
                        Placeholder="Digite uma observação"
                        MaxLength="500"
                        MinimumHeightRequest="110"
                        AutoSize="{OnPlatform Default=TextChanges, WinUI=Disabled}" HeightRequest="{OnPlatform Default=-1, WinUI=180}"/>
                    <Button Text="Adicionar anotação" Style="{StaticResource Buttons}" Command="{Binding SalvarNota}"/>
                </VerticalStackLayout>
            </Border>

            <CollectionView
                Grid.Row="{OnPlatform Default=1, WinUI=0}" Grid.Column="{OnPlatform Default=0, WinUI=1}"
                x:Name="NotesCollectionView"
                ItemsSource="{Binding Notes}"
                VerticalScrollBarVisibility="Default"
                Scrolled="CollectionView_Scrolled">

                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="32" Spacing="8" VerticalOptions="Center">
                        <Label Text="Suas anotações" Style="{StaticResource SectionTitle}"/>
                        <Label Text="Adicione uma anotação para organizar observações e definir lembretes." Style="{StaticResource BodyMuted}"/>
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="model:Note">
                        <Border Style="{StaticResource CardBorder}" Padding="0">
                            <SwipeView>
                                <SwipeView.LeftItems>
                                    <SwipeItem
                                        Style="{StaticResource DangerSwipeItem}"
                                        Text="Excluir"
                                        IconImageSource="{icons:ThemedIcon Icon=Delete48, Role=OnFill}"
                                        Command="{Binding Source={x:Reference NotesCollectionView}, Path=BindingContext.DeleteCommand}"
                                        CommandParameter="{Binding Id}"/>
                                </SwipeView.LeftItems>

                                <SwipeView.RightItems>
                                    <SwipeItem
                                        Text="Notificação"
                                        IconImageSource="{icons:ThemedIcon Icon=Alert24, Role=OnFill}"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource DarkPrimaryLight}}"
                                        Command="{Binding Source={x:Reference NotesCollectionView}, Path=BindingContext.AddNotification}"
                                        CommandParameter="{Binding Id}"/>
                                </SwipeView.RightItems>

                                <VerticalStackLayout 
                                    Spacing="9" 
                                    Padding="10,5"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource DarkSurface}}">
                                    <Label Text="{Binding Content}" Style="{StaticResource CardTitle}" FontSize="16"/>

                                    <HorizontalStackLayout Spacing="4">
                                        <Label Text="Criado em" TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentLight}}" FontSize="13" FontAttributes="Bold"/>
                                        <Label Text="{Binding CreationDate, StringFormat='{0:dd/MM/yyyy HH:mm}'}" Style="{StaticResource BodyMuted}"/>
                                    </HorizontalStackLayout>

                                    <HorizontalStackLayout Spacing="4" IsVisible="{Binding NotifyOn, Converter={converter:NullValueToBoolConverter}}">
                                        <Label Text="Notificar em" TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentLight}}" FontSize="13" FontAttributes="Bold"/>
                                        <Label Text="{Binding NotifyOn, StringFormat='{0:dd/MM/yyyy HH:mm}'}" Style="{StaticResource BodyMuted}"/>
                                    </HorizontalStackLayout>
                                    <FlexLayout Direction="Row" Wrap="Wrap" IsVisible="{OnPlatform Default=False, WinUI=True}">
                                        <Button Text="Lembrete" Style="{StaticResource GhostButton}" Margin="0,4,12,0"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.AddNotification}" CommandParameter="{Binding Id}"/>
                                        <Button Text="Cancelar lembrete" Style="{StaticResource GhostButton}" Margin="0,4,12,0"
                                                IsVisible="{Binding NotifyOn, Converter={converter:NullValueToBoolConverter}}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.CancelNotificationCommand}" CommandParameter="{Binding Id}"/>
                                        <Button Text="Excluir anotação" Style="{StaticResource DangerOutlineButton}" Margin="0,4,0,0"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteCommand}" CommandParameter="{Binding Id}"/>
                                    </FlexLayout>
                                </VerticalStackLayout>
                            </SwipeView>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.Footer>
                    <BoxView HeightRequest="80" BackgroundColor="Transparent"/>
                </CollectionView.Footer>
            </CollectionView>

            <ImageButton
                x:Name="BackToTopButton"
                Grid.RowSpan="3" Grid.Column="{OnPlatform Default=0, WinUI=1}"
                Source="{icons:ThemedIcon Icon=ArrowCircleUp24, Role=OnContainer}"
                Style="{StaticResource FloatingBackToTopButton}"
                Clicked="BackToTopButton_Clicked"/>
        </Grid>
    </RefreshView>
</ContentPage>
