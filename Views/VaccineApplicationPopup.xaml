<?xml version="1.0" encoding="utf-8" ?>
<tk:Popup
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:tk="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:ACS_View.ViewModels"
    xmlns:dto="clr-namespace:ACS_View.Application.DTOs"
    x:Class="ACS_View.Views.VaccineApplicationPopup"
    x:TypeArguments="dto:VaccineApplicationRequestDto"
    x:DataType="vm:VaccineApplicationPopupViewModel"
    WidthRequest="{Binding PopupWidth}"
    CanBeDismissedByTappingOutsideOfPopup="True"
    BackgroundColor="Transparent"
    Padding="0">

    <Border
        Style="{StaticResource CardBorder}"
        Padding="24"
        Margin="0"
        StrokeShape="RoundRectangle 16" StrokeThickness="0">

        <VerticalStackLayout Spacing="12">
            <VerticalStackLayout Spacing="4">
                <Label
                    Text="{Binding Title}"
                    Style="{StaticResource SectionTitle}"
                    HorizontalOptions="Center"/>

                <Label
                    Text="{Binding VaccineTitle}"
                    Style="{StaticResource CardTitle}"
                    HorizontalTextAlignment="Center"/>

                <Label
                    Text="{Binding RecommendedText}"
                    Style="{StaticResource BodyMuted}"
                    HorizontalTextAlignment="Center"/>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="4">
                <Label Text="Data de aplicação" Style="{StaticResource FieldLabel}"/>
                <HorizontalStackLayout>
                    <CheckBox IsChecked="{Binding HasKnownApplicationDate, Mode=TwoWay}"/>
                    <Label Text="Data de aplicação conhecida" Style="{StaticResource BodyMuted}" VerticalTextAlignment="Center"/>
                </HorizontalStackLayout>
                <Label Text="Data de aplicação não informada." Style="{StaticResource BodyMuted}" IsVisible="{Binding HasUnknownApplicationDate}"/>
                <Grid IsVisible="{Binding HasKnownApplicationDate}">
                    <DatePicker
                        Date="{Binding ApplicationDate, Mode=TwoWay}"
                        IsEnabled="{Binding HasKnownApplicationDate}"
                        MaximumDate="{Binding MaximumDate}"/>
                </Grid>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="4">
                <Label Text="Lote" Style="{StaticResource FieldLabel}"/>
                <Grid>
                    <Entry
                        Text="{Binding LotNumber, Mode=TwoWay}"
                        Placeholder="Opcional"/>
                </Grid>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="4">
                <Label Text="Observação" Style="{StaticResource FieldLabel}"/>
                <Grid>
                    <Editor
                        Text="{Binding Notes, Mode=TwoWay}"
                        Placeholder="Opcional"
                        AutoSize="TextChanges"
                        MinimumHeightRequest="82"/>
                </Grid>
            </VerticalStackLayout>

            <Label
                Text="{Binding ErrorMessage}"
                Style="{StaticResource BodyMuted}"
                TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentLight}}"
                IsVisible="{Binding HasError}"/>

            <Grid ColumnDefinitions="{OnPlatform Default='*,*', WinUI='Auto,Auto'}" ColumnSpacing="10" HorizontalOptions="{OnPlatform Default=Fill, WinUI=End}">
                <Button
                    Text="Cancelar"
                    Style="{StaticResource GhostButton}"
                    Clicked="CancelButton_Clicked"/>

                <Button
                    Grid.Column="1"
                    Text="Salvar"
                    Style="{StaticResource Buttons}"
                    Clicked="SaveButton_Clicked"/>
            </Grid>
        </VerticalStackLayout>
    </Border>
</tk:Popup>
