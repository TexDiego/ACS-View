<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ACS_View.ViewModels"
             xmlns:model="clr-namespace:ACS_View.Domain.Entities"
             xmlns:icons="clr-namespace:ACS_View.Controls"
             x:DataType="vm:AddHouseViewModel"
             x:Class="ACS_View.Views.AddHouse"
             Style="{StaticResource PageBackground}"
             Title="Adicionar Residência">

    <Grid
        Padding="24" 
        RowDefinitions="*,Auto"
        RowSpacing="16"
        MaximumWidthRequest="1100" 
        HorizontalOptions="Fill">
        
        <ScrollView VerticalScrollBarVisibility="Default">
            
            <VerticalStackLayout 
                Spacing="20" 
                BindingContext="{Binding HouseModel}"
                x:DataType="model:House">
                
                <Label Text="Endereço da residência" Style="{StaticResource SectionTitle}"/>
                <Label Text="Preencha o CEP para buscar o endereço. Os campos com * são obrigatórios." Style="{StaticResource BodyMuted}"/>
                
                <Grid
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="12"
                    MaximumWidthRequest="440"
                    HorizontalOptions="Fill">

                    <VerticalStackLayout Spacing="4">
                        <Label Text="CEP *" Style="{StaticResource FieldLabel}"/>
                        <Entry Text="{Binding CEP, Mode=TwoWay}" MaxLength="8" Keyboard="Numeric" Placeholder="00000000" TextChanged="Entry_CEP_TextChanged"/>
                    </VerticalStackLayout>
                    
                    <Button
                        Grid.Column="1"
                        Text="Buscar CEP"
                        ImageSource="{icons:ThemedIcon Icon=Search32, Role=OnFill, IconSize=22}"
                        VerticalOptions="End" 
                        Style="{StaticResource Buttons}"
                        Command="{Binding BindingContext.SearchCEP, Source={RelativeSource AncestorType={x:Type ContentPage}}}"/>
                </Grid>
                
                <Grid
                    ColumnDefinitions="{OnPlatform Default='*', WinUI='2*,*'}" 
                    RowDefinitions="{OnPlatform Default='Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto', WinUI='Auto,Auto,Auto,Auto'}" 
                    ColumnSpacing="20"
                    RowSpacing="12">
                    
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Logradouro *" Style="{StaticResource FieldLabel}"/>
                        <Entry Text="{Binding Rua, Mode=TwoWay}" Placeholder="Logradouro"/>
                    </VerticalStackLayout>
                    
                    <VerticalStackLayout
                        Grid.Row="{OnPlatform Default=1, WinUI=0}"
                        Grid.Column="{OnPlatform Default=0, WinUI=1}" 
                        Spacing="4">                        
                        <Label 
                            Text="Número" 
                            Style="{StaticResource FieldLabel}"/>
                        <Entry 
                            Text="{Binding NumeroCasa, Mode=TwoWay}"
                            MaxLength="5" 
                            Placeholder="Número"/>
                    </VerticalStackLayout>
                    
                    <VerticalStackLayout
                        Grid.Row="{OnPlatform Default=2, WinUI=1}"
                        Spacing="4">
                        <Label 
                            Text="Complemento"
                            Style="{StaticResource FieldLabel}"/>
                        <Entry 
                            Text="{Binding Complemento, Mode=TwoWay}"
                            MaxLength="30" 
                            Placeholder="Complemento"/>
                    </VerticalStackLayout>
                    
                    <VerticalStackLayout 
                        Grid.Row="{OnPlatform Default=3, WinUI=1}"
                        Grid.Column="{OnPlatform Default=0, WinUI=1}" 
                        Spacing="4">
                        
                        <Label Text="Bairro" Style="{StaticResource FieldLabel}"/>
                        <Entry Text="{Binding Bairro, Mode=TwoWay}" Placeholder="Bairro"/>
                    </VerticalStackLayout>
                    
                    <VerticalStackLayout 
                        Grid.Row="{OnPlatform Default=4, WinUI=2}"
                        Spacing="4">
                        
                        <Label 
                            Text="Cidade *"
                            Style="{StaticResource FieldLabel}"/>
                        <Entry 
                            Text="{Binding Cidade, Mode=TwoWay}"
                            Placeholder="Cidade"/>
                    </VerticalStackLayout>
                    
                    <VerticalStackLayout Grid.Row="{OnPlatform Default=5, WinUI=2}" Grid.Column="{OnPlatform Default=0, WinUI=1}" Spacing="4"><Label Text="Estado *" Style="{StaticResource FieldLabel}"/><Entry Text="{Binding Estado, Mode=TwoWay}" Placeholder="Estado"/></VerticalStackLayout>
                    <VerticalStackLayout Grid.Row="{OnPlatform Default=6, WinUI=3}" Spacing="4"><Label Text="País *" Style="{StaticResource FieldLabel}"/><Entry Text="{Binding Pais, Mode=TwoWay}" MaxLength="20" Placeholder="País"/></VerticalStackLayout>
                </Grid>
                
                <Label Text="Organização territorial" Style="{StaticResource SectionTitle}"/>
                <Grid ColumnDefinitions="{OnPlatform Default='*', WinUI='*,*'}" RowDefinitions="{OnPlatform Default='Auto,Auto', WinUI='Auto'}" ColumnSpacing="20" RowSpacing="12">
                    <VerticalStackLayout Spacing="4"><Label Text="Setor censitário" Style="{StaticResource FieldLabel}"/><Entry Text="{Binding SetorCensitario, Mode=TwoWay}" Placeholder="Opcional"/></VerticalStackLayout>
                    <VerticalStackLayout Grid.Row="{OnPlatform Default=1, WinUI=0}" Grid.Column="{OnPlatform Default=0, WinUI=1}" Spacing="4"><Label Text="Quadra" Style="{StaticResource FieldLabel}"/><Entry Text="{Binding NumeroQuadra, Mode=TwoWay}" Placeholder="Opcional"/></VerticalStackLayout>
                </Grid>
            </VerticalStackLayout>
        </ScrollView>

        <ActivityIndicator
            IsRunning="{Binding IsRunning}"
            IsVisible="{Binding IsRunning}"
            HeightRequest="60"
            WidthRequest="60"/>

        <Button
            Grid.Row="1"
            VerticalOptions="End"
            Text="Salvar residência"
            HorizontalOptions="{OnPlatform Default=Fill, WinUI=End}"
            Style="{StaticResource Buttons}"
            Command="{Binding SalvarCommand}"/>
    </Grid>
</ContentPage>
