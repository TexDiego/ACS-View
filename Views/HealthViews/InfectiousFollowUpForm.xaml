<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 xmlns:vm="clr-namespace:ACS_View.ViewModels.HealthViewModels" x:Class="ACS_View.Views.HealthViews.InfectiousFollowUpForm" x:DataType="vm:InfectiousFollowUpEditorViewModel">
 <VerticalStackLayout Spacing="10">
  <Label Text="{Binding Summary}" Style="{StaticResource BodyMuted}"/>
  <Button Text="{Binding DetailsButtonText}" Command="{Binding ToggleDetailsCommand}" HorizontalOptions="Start" BackgroundColor="Transparent"
   Padding="0,4" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryLight}}"/>
  <VerticalStackLayout IsVisible="{Binding ShowDetails}" Spacing="8">
   <Picker Title="Situação informada" ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding Status}"/>
   <HorizontalStackLayout><CheckBox IsChecked="{Binding HasTreatmentStarted}"/><Label Text="Informar início do tratamento" VerticalOptions="Center"/></HorizontalStackLayout>
   <DatePicker IsVisible="{Binding HasTreatmentStarted}" Date="{Binding TreatmentStarted}" MaximumDate="{Binding Today}"/>
   <HorizontalStackLayout><CheckBox IsChecked="{Binding HasLastAppointment}"/><Label Text="Informar última consulta" VerticalOptions="Center"/></HorizontalStackLayout>
   <DatePicker IsVisible="{Binding HasLastAppointment}" Date="{Binding LastAppointment}" MaximumDate="{Binding Today}"/>
   <HorizontalStackLayout><CheckBox IsChecked="{Binding HasNextAppointment}"/><Label Text="Informar próxima consulta" VerticalOptions="Center"/></HorizontalStackLayout>
   <DatePicker IsVisible="{Binding HasNextAppointment}" Date="{Binding NextAppointment}"/>
   <Entry Text="{Binding ReferenceService}" Placeholder="Serviço de referência (opcional)"/>
   <Editor Text="{Binding Notes}" Placeholder="Observações do acompanhamento (opcional)" AutoSize="TextChanges"/>
  </VerticalStackLayout>
 </VerticalStackLayout>
</ContentView>
