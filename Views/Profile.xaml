<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ACS_View.ViewModels"
             xmlns:controls="clr-namespace:ACS_View.Controls"
             xmlns:views="clr-namespace:ACS_View.Views"
             x:DataType="vm:ProfileViewModel"
             x:Class="ACS_View.Views.Profile"
             Style="{StaticResource PageBackground}"
             Title="{Binding DisplayName}">

    <ContentPage.ToolbarItems>
        <ToolbarItem
            IconImageSource="{controls:ThemedIcon Icon=SignOut24, Role=OnFill,IconSize=24}"
            Text="Sair" 
            Order="Primary"
            Command="{Binding LogoutCommand}"/>
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="{StaticResource PagePadding}" Spacing="14">
            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Backup e restauração" Style="{StaticResource SectionTitle}"/>
                    <Label Text="Salve uma cópia criptografada deste perfil ou recupere um arquivo .acs." Style="{StaticResource BodyMuted}"/>
                    <Button Text="Backup e restauração" Style="{StaticResource Buttons}" Command="{Binding OpenBackupPage}"/>
                </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Segurança da conta" Style="{StaticResource SectionTitle}"/>
                    <Label Text="{Binding SecurityStatus}" Style="{StaticResource BodyMuted}"/>
                    <Button Text="Senha, recuperação e biometria" Style="{StaticResource Buttons}" Command="{Binding OpenAccountSecurityPage}"/>
                </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Área pessoal" Style="{StaticResource SectionTitle}"/>
                    <Label Text="Acesse anotações e lembretes do seu acompanhamento." Style="{StaticResource BodyMuted}"/>
                    <Button Text="Abrir anotações"
                            Style="{StaticResource Buttons}"
                            Command="{Binding OpenNotesPage}"/>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Importação" Style="{StaticResource SectionTitle}"/>
                    <Label Text="Importe cadastros de pacientes e residências por planilha." Style="{StaticResource BodyMuted}"/>
                    <Button Text="Abrir importação"
                            Style="{StaticResource Buttons}"
                            Command="{Binding OpenImportDataPage}"/>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Dados" Style="{StaticResource SectionTitle}"/>
                    <Label Text="Apague registros associados apenas a este login." Style="{StaticResource BodyMuted}"/>
                    <Button Text="Gerenciar dados"
                            Style="{StaticResource Buttons}"
                            Command="{Binding OpenDataCleanupPage}"/>
                </VerticalStackLayout>
            </Border>

            <Label Text="{x:Static views:App.InstalledVersionLabel}"
                   Style="{StaticResource BodyMuted}"
                   HorizontalTextAlignment="Center"
                   Margin="0,0,0,10"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
