<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 xmlns:vm="clr-namespace:ACS_View.ViewModels.HealthViewModels" xmlns:health="clr-namespace:ACS_View.Views.HealthViews"
 x:Class="ACS_View.Views.HealthViews.ImmuneFollowUpView" x:DataType="vm:InfectiousFollowUpViewModel">
 <VerticalStackLayout Spacing="12">
  <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}"/>
  <Label Text="{Binding Title}" Style="{StaticResource CardTitle}"/>
  <Label Text="Condição informada no cadastro" Style="{StaticResource BodyMuted}"/>
  <Label Text="{Binding Message}" Style="{StaticResource BodyMuted}"/>
  <Button Text="Tentar novamente" Command="{Binding RetryCommand}" IsVisible="{Binding HasError}"/>
  <health:InfectiousFollowUpForm BindingContext="{Binding Editor}"/>
  <Button Text="Salvar acompanhamento" Command="{Binding SaveCommand}" IsVisible="{Binding Editor.ShowDetails}"/>
 </VerticalStackLayout>
</ContentView>
