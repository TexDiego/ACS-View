<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ACS_View.ViewModels"
             x:DataType="vm:ImportDataViewModel"
             x:Class="ACS_View.Views.ImportDataPage"
             Style="{StaticResource PageBackground}"
             Title="Importar dados">

    <ScrollView>
        <VerticalStackLayout Padding="{StaticResource PagePadding}" Spacing="14">
            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Pacientes" Style="{StaticResource SectionTitle}"/>

                    <Label Text="As colunas de pacientes, condições de saúde e vínculos familiares são reconhecidas automaticamente."
                           Style="{StaticResource BodyMuted}"
                           LineBreakMode="WordWrap"/>

                    <Button Text="Selecionar planilha de pacientes"
                            Style="{StaticResource Buttons}"
                            IsEnabled="{Binding CanStartImport}"
                            Command="{Binding ImportPatientsCommand}"/>

                    <VerticalStackLayout Spacing="8" IsVisible="{Binding IsImporting}">
                        <ProgressBar Progress="{Binding ImportProgress}"/>
                        <Label Text="{Binding ImportProgressText}"
                               Style="{StaticResource BodyMuted}"
                               LineBreakMode="WordWrap"/>
                        <Button Text="Cancelar importação"
                                Style="{StaticResource GhostButton}"
                                IsEnabled="{Binding CanCancelImport}"
                                Command="{Binding CancelImportCommand}"/>
                    </VerticalStackLayout>

                    <Label Text="{Binding PatientImportSummary}"
                           Style="{StaticResource BodyMuted}"
                           LineBreakMode="WordWrap"/>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Residências" Style="{StaticResource SectionTitle}"/>

                    <Label Text="As colunas de endereços das residências são reconhecidas automaticamente."
                           Style="{StaticResource BodyMuted}"
                           LineBreakMode="WordWrap"/>

                    <Button Text="Selecionar planilha de residências"
                            Style="{StaticResource Buttons}"
                            IsEnabled="{Binding CanStartHouseImport}"
                            Command="{Binding ImportHousesCommand}"/>

                    <VerticalStackLayout Spacing="8" IsVisible="{Binding IsHouseImporting}">
                        <ProgressBar Progress="{Binding HouseImportProgress}"/>
                        <Label Text="{Binding HouseImportProgressText}"
                               Style="{StaticResource BodyMuted}"
                               LineBreakMode="WordWrap"/>
                        <Button Text="Cancelar importação"
                                Style="{StaticResource GhostButton}"
                                IsEnabled="{Binding CanCancelHouseImport}"
                                Command="{Binding CancelHouseImportCommand}"/>
                    </VerticalStackLayout>

                    <Label Text="{Binding HouseImportSummary}"
                           Style="{StaticResource BodyMuted}"
                           LineBreakMode="WordWrap"/>
                </VerticalStackLayout>
            </Border>

            <Label 
                Text="As colunas equivalentes são reconhecidas automaticamente. Campos ausentes ou vazios preservam o cadastro; valores preenchidos atualizam os dados. As observações são complementadas." 
                LineBreakMode="WordWrap" 
                Style="{StaticResource BodyMuted}"/>
            
            <Button 
                Text="Histórico de importações" 
                Style="{StaticResource Buttons}" 
                Command="{Binding OpenImportHistoryCommand}"
                Margin="0,0,0,20"/>

            <ActivityIndicator IsVisible="{Binding IsRunning}"
                               IsRunning="{Binding IsRunning}"
                               HorizontalOptions="Center"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
