<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ACS_View.ViewModels"
             xmlns:dto="clr-namespace:ACS_View.Application.DTOs"
             xmlns:controls="clr-namespace:ACS_View.Controls"
             Style="{StaticResource PageBackground}"
             x:DataType="vm:VetorialControlViewModel"
             x:Class="ACS_View.Views.VetorialControl"
             Title="Controle Vetorial">

    <ContentPage.ToolbarItems>
        <ToolbarItem
            IconImageSource="{controls:ThemedIcon Icon=Settings24, Role=OnFill}"
            ToolTipProperties.Text="Configurar residências em lote"
            Command="{Binding OptionsCommand}"/>
    </ContentPage.ToolbarItems>

    <ContentPage.Resources>
        <DataTemplate
            x:Key="Sector"
            x:DataType="dto:VectorControlRow">

            <Label
                Text="{Binding Title}"
                FontAttributes="Bold"
                FontSize="20"
                Padding="8,16,8,8"
                TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource AccentLight}}"/>
        </DataTemplate>

        <DataTemplate
            x:Key="Block"
            x:DataType="dto:VectorControlRow">

            <Label
                Text="{Binding Title}"
                FontAttributes="Bold"
                Padding="20,12,8,8"
                Style="{StaticResource BodyMuted}"/>
        </DataTemplate>

        <DataTemplate
            x:Key="Residence"
            x:DataType="dto:VectorControlRow">

            <Border
                Style="{StaticResource CardBorder}"
                Margin="24,2,0,4" Padding="12">

                <Border.GestureRecognizers>
                    <TapGestureRecognizer
                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:VetorialControlViewModel}}, Path=FamilyCommand}"
                        CommandParameter="{Binding .}"/>
                </Border.GestureRecognizers>

                <Label
                    Text="{Binding Title}"
                    Style="{StaticResource BodyMuted}"/>
            </Border>
        </DataTemplate>

        <controls:VectorControlTemplateSelector
            x:Key="Rows"
            SectorTemplate="{StaticResource Sector}"
            BlockTemplate="{StaticResource Block}"
            ResidenceTemplate="{StaticResource Residence}"/>

    </ContentPage.Resources>

    <Grid
        Padding="16,0"
        RowDefinitions="Auto,Auto,*"
        RowSpacing="0">

        <Grid
            ColumnDefinitions="Auto,*"
            ColumnSpacing="8"
            HorizontalOptions="Center">

            <Label
                Text="Pesquisar por:"
                Style="{StaticResource BodyMuted}"
                VerticalOptions="Center"/>

            <Picker
                Grid.Column="1"
                Title="Tipo de pesquisa"
                ItemsSource="{Binding SearchModes}"
                SelectedIndex="{Binding SearchModeIndex, Mode=TwoWay}"/>
        </Grid>

        <Border
            Grid.Row="1"
            Style="{StaticResource SearchPanel}"
            Margin="0,0,0,0"
            Padding="0,0,0,0">

            <SearchBar
                Placeholder="{Binding SearchPlaceholder}"
                Text="{Binding SearchText, Mode=TwoWay}"
                SearchCommand="{Binding SearchCommand}"
                MaxLength="80"
                Margin="0,0,0,-2"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceContainerHigh}, Dark={StaticResource DarkSurfaceContainerHigh}}"/>
        </Border>

        <CollectionView
            Grid.Row="2"
            ItemsSource="{Binding Items}"
            ItemTemplate="{StaticResource Rows}"
            SelectionMode="None"
            VerticalScrollBarVisibility="Never">

            <CollectionView.EmptyView>
                <Label
                    Text="{Binding EmptyMessage}"
                    Style="{StaticResource BodyMuted}"
                    Padding="16"/>
            </CollectionView.EmptyView>

            <CollectionView.Footer>
                <BoxView
                    Background="Transparent"
                    HeightRequest="16"/>
            </CollectionView.Footer>

        </CollectionView>

        <ActivityIndicator
            Grid.Row="2"
            IsRunning="{Binding IsLoading}"
            IsVisible="{Binding IsLoading}"/>

    </Grid>
</ContentPage>
