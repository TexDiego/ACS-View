<?xml version="1.0" encoding="utf-8" ?>
<tk:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
        xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
        xmlns:tk="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
        xmlns:vm="clr-namespace:ACS_View.ViewModels"
        xmlns:health="clr-namespace:ACS_View.Application.Health"
        xmlns:values="clr-namespace:ACS_View.Domain.ValueObjects"
        xmlns:icons="clr-namespace:ACS_View.Controls"
        xmlns:converters="clr-namespace:ACS_View.Converters"
        xmlns:local="clr-namespace:ACS_View.Views"
        x:Class="ACS_View.Views.PersonsInfo"
        x:DataType="vm:PersonsInfoViewModel"
        BackgroundColor="Transparent"
        Padding="0">

    <tk:Popup.Resources>
        <Style x:Key="EdgeAction" TargetType="ImageButton">
            <Setter Property="WidthRequest" Value="44"/>
            <Setter Property="HeightRequest" Value="44"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimaryLight}}"/>
        </Style>
        <Style x:Key="EdgeAction2" TargetType="Button">
            <Setter Property="HeightRequest" Value="44"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimaryLight}}"/>
        </Style>
    </tk:Popup.Resources>

    <Grid
        x:Name="Composition"
        ColumnDefinitions="*,*"
        ColumnSpacing="12"
        RowDefinitions="auto"
        VerticalOptions="Center">

        <Grid
            x:Name="MainPanel"
            Grid.Column="0"
            RowDefinitions="22,auto,22,22"
            VerticalOptions="Center">

            <Border
                Grid.Row="1"
                Grid.RowSpan="2"
                StrokeShape="RoundRectangle 18"
                Padding="16,26,16,16"
                BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource DarkSurface}}"
                VerticalOptions="Start">

                <Grid
                    RowDefinitions="Auto,*"
                    RowSpacing="12">

                    <Grid
                        ColumnDefinitions="*,Auto"
                        ColumnSpacing="8">

                        <Label
                            Text="Cadastro individual"
                            Style="{StaticResource CardTitle}"/>

                        <Border
                            Grid.Column="1"
                            StrokeShape="RoundRectangle 10"
                            Padding="7,2"
                            ToolTipProperties.Text="{Binding PersonInfo.Sexo, StringFormat='Sexo: {0}'}"
                            SemanticProperties.Description="{Binding PersonInfo.Sexo, StringFormat='Sexo: {0}'}">

                            <Label
                                Text="{Binding PersonInfo.Sexo, StringFormat='Sexo {0}'}"
                                FontSize="12"
                                FontAttributes="Bold"
                                VerticalOptions="Center"/>
                        </Border>
                    </Grid>

                    <ScrollView Grid.Row="1">

                        <VerticalStackLayout Spacing="10">

                            <Label
                                x:Name="PatientNameLabel"
                                Text="{Binding PersonInfo.Name}"
                                FontSize="24"
                                FontAttributes="Bold"/>

                            <HorizontalStackLayout Spacing="8">

                                <Label x:Name="BirthDateLabel" Text="{Binding PersonInfo.BirthDate, StringFormat='{0:dd/MM/yyyy}'}"/>

                                <Label Text="{Binding PersonInfo.BirthDate, Converter={converters:DateTimeToAgeConverter}}"/>
                            </HorizontalStackLayout>

                            <Label
                                x:Name="MotherNameLabel"
                                Text="{Binding PersonInfo.MotherName, StringFormat='Mãe: {0}'}"
                                IsVisible="{Binding PersonInfo.MotherName, Converter={converters:NullValueToBoolConverter}}">

                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Buttons="Primary"
                                        Command="{Binding OpenLinkedParentCommand}"
                                        CommandParameter="{Binding PersonInfo.MotherPatientId}"/>
                                </Label.GestureRecognizers>
                            </Label>

                            <Label
                                x:Name="FatherNameLabel"
                                Text="{Binding PersonInfo.FatherName, StringFormat='Pai: {0}'}"
                                IsVisible="{Binding PersonInfo.FatherName, Converter={converters:NullValueToBoolConverter}}">

                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Buttons="Primary"
                                        Command="{Binding OpenLinkedParentCommand}"
                                        CommandParameter="{Binding PersonInfo.FatherPatientId}"/>
                                </Label.GestureRecognizers>
                            </Label>

                            <Label
                                x:Name="CnsLabel"
                                Text="{Binding MainSus, Converter={converters:SUSFormatConverter}, StringFormat='CNS: {0}'}"
                                IsVisible="{Binding MainSus, Converter={converters:NullValueToBoolConverter}}"/>

                            <Label
                                x:Name="NisLabel"
                                Text="{Binding NisNumber, Converter={converters:NISFormatConverter}, StringFormat='NIS: {0}'}"
                                IsVisible="{Binding NisNumber, Converter={converters:NullValueToBoolConverter}}"/>

                            <Label
                                Text="{Binding MainPhone, Converter={converters:PhoneFormatConverter}}"
                                IsVisible="{Binding MainPhone, Converter={converters:NullValueToBoolConverter}}"/>

                            <Label
                                x:Name="AddressLabel"
                                Text="{Binding Endereco}"
                                TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryLight}}">

                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Buttons="Primary" Command="{Binding GoToFamilyCommand}"/>
                                </Label.GestureRecognizers>
                            </Label>

                            <Label
                                x:Name="AddressComplementLabel"
                                Text="{Binding Complemento}"
                                IsVisible="{Binding Complemento, Converter={converters:NullValueToBoolConverter}}"/>

                            <Label
                                Text="{Binding PersonInfo.Observacao}"
                                IsVisible="{Binding PersonInfo.Observacao, Converter={converters:NullValueToBoolConverter}}"
                                FontAttributes="Italic"/>

                            <Label
                                Text="Condições de saúde"
                                Style="{StaticResource CardTitle}"/>

                            <FlexLayout
                                Wrap="Wrap"
                                BindableLayout.ItemsSource="{Binding Icons}">

                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="values:HealthIcon">

                                        <VerticalStackLayout
                                            Spacing="6"
                                            Padding="4"
                                            Margin="0,0,8,6">

                                            <VerticalStackLayout.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type local:PersonsInfo}}, Path=BindingContext.OpenConditionCommand}"
                                                    CommandParameter="{Binding .}"/>
                                            </VerticalStackLayout.GestureRecognizers>

                                            <Image
                                                Source="{Binding IconSource}"
                                                HeightRequest="26"
                                                WidthRequest="26"
                                                ToolTipProperties.Text="{Binding Description}"/>
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>

                            <Label
                                Text="{Binding VisitFollowUpInfo}"
                                Style="{StaticResource BodyMuted}"
                                Margin="0,0,0,15"
                                ToolTipProperties.Text="Ver o acompanhamento de visitas">

                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding OpenHealthCommand}"
                                        CommandParameter="visits"/>
                                </Label.GestureRecognizers>
                            </Label>
                        </VerticalStackLayout>
                    </ScrollView>
                </Grid>
            </Border>

            <HorizontalStackLayout
                Grid.RowSpan="2"
                ZIndex="1"
                Spacing="6"
                HorizontalOptions="End"
                VerticalOptions="Start"
                Margin="12,0">

                <ImageButton
                    Style="{StaticResource EdgeAction}"
                    Source="{icons:ThemedIcon Icon=PhoneChat16, Role=OnFill, IconSize=22}"
                    Command="{Binding OpenWhatsAppCommand}"
                    ToolTipProperties.Text="Conversar no WhatsApp"
                    SemanticProperties.Description="Conversar no WhatsApp"/>

                <ImageButton
                    Style="{StaticResource EdgeAction}"
                    Source="{icons:ThemedIcon Icon=Pen28, Role=OnFill, IconSize=22}"
                    Command="{Binding EditPerson}"
                    ToolTipProperties.Text="Editar cadastro"
                    SemanticProperties.Description="Editar cadastro"/>

                <ImageButton
                    Style="{StaticResource EdgeAction}"
                    Source="{icons:ThemedIcon Icon=PersonHeart24, Role=OnFill, IconSize=22}"
                    Command="{Binding OpenHealthCommand}"
                    ToolTipProperties.Text="Abrir acompanhamento"
                    SemanticProperties.Description="Abrir acompanhamento"/>

                <ImageButton
                    Style="{StaticResource EdgeAction}"
                    Source="{icons:ThemedIcon Icon=Branch24, Role=OnFill, IconSize=22}"
                    Command="{Binding FamilyLinks.DrawCommand}"
                    IsVisible="{Binding FamilyLinks.CanDraw}"
                    ToolTipProperties.Text="Abrir árvore genealógica"
                    SemanticProperties.Description="Abrir árvore genealógica"/>

                <ImageButton
                    Style="{StaticResource EdgeAction}"
                    Padding="0"
                    Margin="20,0,0,0"
                    Source="{icons:ThemedIcon Icon=Dismiss24, Role=OnFill, IconSize=22}"
                    Clicked="OnCloseClicked"
                    ToolTipProperties.Text="Fechar cadastro individual"
                    SemanticProperties.Description="Fechar cadastro individual"/>
            </HorizontalStackLayout>

            <Button
                Grid.Row="2"
                Grid.RowSpan="2"
                VerticalOptions="Center"
                HorizontalOptions="Center"
                Text="Visita rápida"
                ZIndex="1"
                Style="{StaticResource EdgeAction2}"
                ImageSource="{icons:ThemedIcon Icon=ClipboardTextEdit24, Role=OnFill, IconSize=22}"
                Command="{Binding RegisterQuickVisitCommand}"
                ToolTipProperties.Text="Registrar visita agora"
                SemanticProperties.Description="Registrar visita agora"/>
        </Grid>

        <Grid
            Grid.Column="1"
            x:Name="HealthPanel"
            IsVisible="{Binding IsHealthPanelVisible}"
            Padding="0"
            RowDefinitions="22,auto"
            VerticalOptions="Center"
            HorizontalOptions="Fill">

            <Border
                Grid.Row="1"
                StrokeShape="RoundRectangle 18"
                Padding="16"
                BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource DarkSurface}}"
                VerticalOptions="Center"
                HorizontalOptions="Fill">

                <Grid
                    HorizontalOptions="Fill"
                    VerticalOptions="Center"
                    RowDefinitions="Auto,Auto,Auto,*"
                    RowSpacing="10">

                    <Grid
                        Grid.Row="0"
                        VerticalOptions="Start"
                        HorizontalOptions="Fill">
                        
                        <Label
                            Text="Acompanhamento"
                            Style="{StaticResource CardTitle}"
                            VerticalOptions="Center"
                            HorizontalOptions="Start"/>

                        <ImageButton
                            Style="{StaticResource EdgeAction}"
                            Source="{icons:ThemedIcon Icon=Dismiss24, Role=OnFill,IconSize=22}"
                            VerticalOptions="Start"
                            HorizontalOptions="End"
                            Command="{Binding CloseHealthCommand}"/>
                    </Grid>

                    <Picker
                        Grid.Row="1"
                        Title="Escolher módulo"
                        ItemsSource="{Binding HealthModules}"
                        ItemDisplayBinding="{Binding Title}"
                        SelectedItem="{Binding SelectedHealthModule}"/>

                    <VerticalStackLayout 
                        Grid.Row="2" 
                        BackgroundColor="Transparent">

                        <Label
                            Text="{Binding HealthStatus}"
                            Style="{StaticResource BodyMuted}"/>

                        <Button
                            Text="Recarregar módulos disponíveis"
                            Command="{Binding RetryHealthCommand}"
                            IsVisible="{Binding HealthStatus, Converter={converters:NullValueToBoolConverter}}"/>
                    </VerticalStackLayout>

                    <ScrollView 
                        Grid.Row="3" 
                        BackgroundColor="Transparent" 
                        Padding="0"
                        VerticalOptions="Center">
                        
                        <ContentView
                            Content="{Binding HealthContent}" 
                            Padding="0"
                            Margin="0"
                            VerticalOptions="Center"/>
                    </ScrollView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</tk:Popup>
